rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares
    function estaAutenticado() {
      return request.auth != null;
    }

    function correoUsuario() {
      return request.auth.token.email.lower();
    }

    function existeDocUsuario() {
      return estaAutenticado() && exists(/databases/$(database)/documents/usuarios/$(correoUsuario()));
    }

    function obtenerDatosUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(correoUsuario())).data;
    }

    function tieneRol(rolEsperado) {
      return existeDocUsuario() &&
             obtenerDatosUsuario().activo != false &&
             obtenerDatosUsuario().rol == rolEsperado;
    }

    function esAdmin() {
      return tieneRol('ADMIN');
    }

    function esOperador() {
      return tieneRol('OPERADOR') || esAdmin();
    }

    function esAdmision() {
      return tieneRol('ADMISION') || esAdmin();
    }

    function esMedico() {
      return tieneRol('MEDICO') || esAdmin();
    }

    function puedeModificarAtenciones() {
      return existeDocUsuario() &&
             obtenerDatosUsuario().activo != false &&
             (obtenerDatosUsuario().rol in ['ADMIN', 'OPERADOR', 'ADMISION', 'MEDICO']);
    }

    // 1. USUARIOS (Gestión de perfiles)
    match /usuarios/{userId} {
      allow read: if true;
      allow create: if estaAutenticado();
      allow update, delete: if esAdmin();
    }

    // 2. PROGRAMACIÓN MÉDICA (Pantalla TV y Consultorios)
    match /programacion_medica/{documentId} {
      allow read: if true;
      allow create, delete: if esAdmin() || esOperador();
      allow update: if puedeModificarAtenciones();
    }

    // 3. LISTA DE ESPERA (Triaje y Cola de espera)
    match /lista_espera/{documentId} {
      allow read: if true;
      allow create, update: if puedeModificarAtenciones();
      allow delete: if esAdmin() || esAdmision();
    }

    // 4. HISTORIAL DE AUDITORÍA Y LLAMADOS
    match /historial_llamados/{documentId} {
      allow read: if true;
      allow create, update: if puedeModificarAtenciones();
      allow delete: if esAdmin();
    }

    // 5. REGISTRO DE ATENCIONES Y PACIENTES
    match /pacientes_medico/{documentId} {
      allow read: if true;
      allow create, update: if puedeModificarAtenciones();
      allow delete: if esAdmin();
    }

    // 6. CITAS DE CONSULTA EXTERNA (Pacientes citados del día y adicionales)
    match /citas_consulta_externa/{documentId} {
      allow read: if true;
      allow create, update, delete: if puedeModificarAtenciones();
    }

    // 7. CONFIGURACIÓN (Comunicado de cabecera)
    match /configuracion/{documentId} {
      allow read: if true;
      allow write: if esAdmin();
    }
  }
}
